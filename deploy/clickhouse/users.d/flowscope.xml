<!--
  Local-dev ClickHouse user grants for the flowscope account. Mounted
  read-only at /etc/clickhouse-server/users.d/ by docker-compose.yml.
  Production credentials live on the VM cloud-init payload, not here.
-->
<clickhouse>
  <users>
    <flowscope>
      <password>flowscope</password>
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <access_management>1</access_management>
      <named_collection_control>1</named_collection_control>
    </flowscope>
  </users>
</clickhouse>
